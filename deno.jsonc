{
	"lock": false,
	"name": "@li/worker-runner",
	"version": "0.0.0",
	"license": "MIT",
	"exports": {
		".": "./src/mod.ts"
	},
	"tasks": {
		"test": "deno test -R"
	},
	"imports": {
		"@std/assert": "jsr:@std/assert@^1.0.11",
		"@std/random": "jsr:@std/random@^0.1.5"
	},
	"fmt": {
		"semiColons": false,
		"useTabs": true,
		"lineWidth": 120,
		"indentWidth": 4,
		"singleQuote": true,
		"proseWrap": "preserve",
		"exclude": ["README.md"]
	},
	"compilerOptions": { "strict": true },
	"lint": {
		"exclude": [],
		"rules": {
			"tags": ["recommended"],
			"exclude": [],
			"include": []
		}
	},
	"exclude": []
}
